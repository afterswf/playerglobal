{
  "name": "@afterswf/playerglobal",
  "version": "0.2.461",
  "description": "Global class definitions for the AS3 language",
  "main": "bundle/awayfl-playerglobal.umd.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "url": "http://www.away3d.com",
  "author": "Rob Bateman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afterswf/playerglobal.git"
  },
  "scripts": {
    "rimraf": "rimraf",
    "rollup": "rollup -c",
    "tsc": "tsc",
    "tsc:build": "npm run tsc || exit 0",
    "clean": "npm cache clean && npm run rimraf -- node_modules dist bundle",
    "clean:dist": "npm run rimraf -- dist bundle",
    "watch": "npm run tsc -- --w",
    "eslint": "eslint ./lib --fix",
    "eslint:commit": "npm run eslint && npm run --silent gitdiff || git add -u && git commit -m \"fixed by eslint\"",
    "gitdiff": "git diff --quiet && git diff --cached --quiet",
    "prebuild": "npm run clean:dist",
    "build": "npm run tsc:build && npm run rollup",
    "prepare": "npm run tsc:build",
    "prepublishOnly": "node bumpIfPublished.mjs && npm run build",
    "copyVersionToIndex": "node ./copyVersionToIndex && git add ./index.ts && git commit -m \"update version number in index.ts\"",
    "version": "npm run copyVersionToIndex && npm run build"
  },
  "keywords": [
    "AwayJS",
    "WebGL",
    "2D",
    "3D",
    "graphics"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/afterswf/playerglobal/issues"
  },
  "homepage": "https://github.com/afterswf/playerglobal#readme",
  "peerDependencies": {
    "@awayfl/avm2": "npm:@afterswf/avm2@^0.2.241",
    "@awayfl/swf-loader": "^0.4.0",
    "@awayjs/core": "^0.9.0",
    "@awayjs/graphics": "npm:@afterswf/graphics@^0.5.101",
    "@awayjs/materials": "^0.6.0",
    "@awayjs/scene": "npm:@afterswf/scene@^0.13.325",
    "@awayjs/stage": "^0.11.0",
    "@awayjs/view": "^0.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@awayfl/avm2": "npm:@afterswf/avm2@^0.2.241",
    "@awayfl/swf-loader": "^0.4.0",
    "@awayjs/core": "^0.9.0",
    "@awayjs/graphics": "npm:@afterswf/graphics@^0.5.101",
    "@awayjs/materials": "^0.6.0",
    "@awayjs/renderer": "npm:@afterswf/renderer@^0.11.99",
    "@awayjs/scene": "npm:@afterswf/scene@^0.13.325",
    "@awayjs/stage": "^0.11.0",
    "@awayjs/view": "^0.6.0",
    "@rollup/plugin-commonjs": "^18.0.0",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "@rollup/plugin-terser": "^0.4.3",
    "@types/wicg-file-system-access": "^2020.9.5",
    "@typescript-eslint/eslint-plugin": "^4.4.1",
    "@typescript-eslint/parser": "^4.4.1",
    "eslint": "^7.11.0",
    "rimraf": "^2.5.2",
    "rollup": "^2.79.1",
    "tslib": "^2.3.0",
    "typescript": "^4.9.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
